# Frontend Environment Variables
VITE_CONTRACT_ADDRESS="your_contract_address"
VITE_MIN_GPA_THRESHOLD="800"
VITE_MAX_INCOME_THRESHOLD="250000"

# Backend Environment Variables (Vercel API)
# Prisma Neon DB connection string
DATABASE_URL="postgres://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
